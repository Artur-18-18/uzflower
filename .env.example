# UzFlower Telegram Bot Configuration
# Скопируйте этот файл в .env и заполните значения

# ============================================================
# Telegram Bot Settings
# ============================================================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=8676150074:AAFXKPfATw1cPrJVxiV4OP4vbmgdlHaEKN0

# ID Telegram канала (username или числовой ID)
# Для получения ID перешлите пост из канала в @userinfobot
# Пример: @flowers_shop или -1001234567890
TELEGRAM_CHANNEL_ID=@uzflower_shop

# ID владельца для уведомлений о заказах
# Для получения своего ID напишите @userinfobot
TELEGRAM_OWNER_ID=0

# Включить запуск ботов на сервере (для Render.com)
# true = боты запускаются вместе с сервером
# false = только API сервер (боты запускаются отдельно)
ENABLE_TELEGRAM_BOTS=true

# ============================================================
# Admin Bot Settings (@uzfloweradmin_bot)
# ============================================================

# Токен админ-бота от @BotFather
ADMIN_BOT_TOKEN=8443193754:AAHWu7NqH9nE7UHshZW4Jb0M3TqqMdlRcSA

# ID владельца/администратора для обработки заказов
# Для получения своего ID напишите @userinfobot
ADMIN_USER_ID=1186442364

# Список ID администраторов (через запятую) для поддержки нескольких админов
# Если не указан, используется ADMIN_USER_ID
# Пример: ADMIN_IDS=1186442364,123456789,987654321
ADMIN_IDS=1186442364

# URL API сайта
# ВАЖНО: На Render.com оставьте http://localhost:8000
# Боты работают в том же контейнере, что и сервер
TELEGRAM_API_URL=http://localhost:8000

# Секретный ключ для авторизации бота в API
# Должен совпадать с TELEGRAM_BOT_SECRET_KEY в main.py
TELEGRAM_API_SECRET=telegram-bot-secret-key

# ============================================================
# Database Settings
# ============================================================

DATABASE_URL=sqlite:///./uzflower.db

# ============================================================
# Cloudinary Settings (optional)
# ============================================================

# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
